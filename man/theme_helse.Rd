\name{theme_helse}
\alias{theme_helse}
\title{ggplot2 theme for Norwegian Health Trust plots}
\usage{
theme_helse(base_size = 11, base_family = "Calibri", title_family = base_family)
}
\arguments{
\item{base_size}{Base font size.}

\item{base_family}{Base font family. Defaults to \code{"Calibri"}.}

\item{title_family}{Title font family. Defaults to \code{base_family}.}
}
\value{
A ggplot2 theme.
}
\description{
A restrained ggplot2 theme using the programme's main blue as the primary
text/accent colour and Calibri as the default family. The font is not bundled
with this package.
}
