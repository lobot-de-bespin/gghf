\name{helse_palette}
\alias{helse_palette}
\title{Norwegian Health Trust colour palette}
\usage{
helse_palette(names = NULL)
}
\arguments{
\item{names}{Optional colour names. If \code{NULL}, all colours are returned.}
}
\value{
A named character vector of HEX colours.
}
\description{
Returns colours from the national visual identity programme for Norwegian
health trusts. Values are the official web HEX values from the programme.
}
